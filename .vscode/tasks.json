{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: run API on 8010",
      "type": "shell",
      "command": "C:\\Users\\dagar\\.venvs\\loan-covenant\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--reload",
        "--port",
        "8010"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: run Next dev",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Dev: backend + frontend",
      "dependsOn": [
        "Backend: run API on 8010",
        "Frontend: run Next dev"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
