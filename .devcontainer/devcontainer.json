{
  "name": "Loan Covenant Agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "postCreateCommand": "bash .devcontainer/install-ollama.sh",
  "forwardPorts": [3000, 8000, 11434],
  "portsAttributes": {
    "3000": {
      "label": "Frontend"
    },
    "8000": {
      "label": "Backend API"
    },
    "11434": {
      "label": "Ollama"
    }
  }
}
